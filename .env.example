# Copiar a .env.local y completar con los valores del entorno local de Supabase.
# No incluir claves reales en este archivo ni en el repositorio.

# URL del API local de Supabase (npx supabase status).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Clave publica del entorno local. Es publica por diseno: la proteccion real es RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Credencial administrativa. Solo servidor y scripts: nunca en NEXT_PUBLIC_*.
SUPABASE_ADMIN_KEY=

# Origen permitido por la aplicacion.
APP_ORIGIN=http://localhost:3000

# Entorno logico: local | test | desarrollo.
APP_ENV=local

# Habilita la creacion idempotente de usuarios demo solo en entorno local.
DEMO_SEED_ENABLED=false

# Contraseña demo local de al menos 12 caracteres. No versionar valores reales.
DEMO_USER_PASSWORD=
